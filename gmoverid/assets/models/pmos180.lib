* ============================================================
* PTM 180nm PMOS BSIM3v3 Model  (SVT / LVT / HVT variants)
* Arizona State University Predictive Technology Model
* Source: http://ptm.asu.edu/  (bulk 180nm, PMOS)
* Simulator: ngspice (LEVEL=8 = BSIM3v3)
*
* Vth convention  (VTH0 negative for PMOS):
*   SVT: VTH0 = -0.42 V
*   LVT: VTH0 = -0.32 V  (|VTH0| - 0.10 V)
*   HVT: VTH0 = -0.57 V  (|VTH0| + 0.15 V)
* ============================================================

* ── SVT (nominal) ────────────────────────────────────────────────────────────
.model pmos180 PMOS LEVEL=8
+TNOM   = 27          TOX    = 4.1E-9       XJ     = 1E-7
+NCH    = 6.0165E16   VTH0   = -0.42        K1     = 0.4087
+K2     = -7.588E-3   K3     = 2.0          K3B    = 10.534
+W0     = 1E-7        NLX    = 1.74E-7
+DVT0W  = 0           DVT1W  = 0            DVT2W  = 0
+DVT0   = 2.4793      DVT1   = 0.553        DVT2   = -0.0296
+U0     = 117.5       UA     = 2.0245E-9    UB     = 1.78E-18
+UC     = -2.04E-11   VSAT   = 1.054E5
+A0     = 2.7748      AGS    = 0.6544
+B0     = 1.81E-7     B1     = 1E-6
+KETA   = 0.01        A1     = 1.3842E-3    A2     = 0.3
+RDSW   = 600         PRWG   = -0.2         PRWB   = 0
+WR     = 1           WINT   = -1.16E-8     LINT   = 2.43E-8
+DWG    = -2.38E-9    DWB    = 8.48E-9
+VOFF   = -0.0948     NFACTOR= 1.3          CIT    = 0
+CDSC   = 2.4E-4      CDSCD  = 0            CDSCB  = 0
+ETA0   = 2.2E-3      ETAB   = -5.8E-3      DSUB   = 1.0
+PCLM   = 2.0         PDIBLC1= 0.1          PDIBLC2= 2.0E-3
+PDIBLCB= 0           DROUT  = 0.5
+PSCBE1 = 8E10        PSCBE2 = 6.0E-10      PVAG   = 1E-20
+DELTA  = 0.01        RSH    = 6.9          MOBMOD = 1
+PRT    = 0           UTE    = -1.5         KT1    = -0.11
+KT1L   = 0           KT2    = 0.022        UA1    = 4.31E-9
+UB1    = -7.61E-18   UC1    = -5.6E-11     AT     = 3.3E4
+WL     = 0           WLN    = 1            WW     = 0
+WWN    = 1           WWL    = 0            LL     = 0
+LLN    = 1           LW     = 0            LWN    = 1    LWL = 0
+CAPMOD = 2           XPART  = 0.5
+CGDO   = 6.8E-10     CGSO   = 6.8E-10      CGBO   = 1E-12
+CJ     = 1.24E-3     PB     = 0.9          MJ     = 0.4724
+CJSW   = 3.03E-10    PBSW   = 0.98         MJSW   = 0.3504
+CJSWG  = 2.6E-10     PBSWG  = 0.98         MJSWG  = 0.3504
+CF     = 0
+PVTH0  = -5.21E-3    PRDSW  = 1.4884878    PK2    = 1.1313E-3
+WKETA  = 3.0E-3      LKETA  = -0.0106539
+PU0    = -5.7E-3     PUA    = -5.8E-11     PUB    = 1E-21
+PVSAT  = 50          PETA0  = 1E-4         PKETA  = -2E-3

